rules_version = '2';
// ═══════════════════════════════════════════════════════════════
// U.U.R. Finance Network — SUGGESTED Firestore rules
// You said rules are handled on your side — this file only exists
// because the rebuild ADDS collections and a "manager" role.
// Merge the new pieces into your existing rules:
//   NEW collections: fx, certificates, vnbNotices, networkNotices
//   NEW role:        users/{uid}.role == 'manager' (staff powers)
// ═══════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me()       { return request.auth.uid; }
    function userDoc()  { return get(/databases/$(database)/documents/users/$(me())).data; }
    function isAdmin() {
      return signedIn() && (
        exists(/databases/$(database)/documents/admins/$(me())) ||
        userDoc().role == 'admin'
      );
    }
    // Managers are player-staff who may service other players' accounts.
    function isStaff() {
      return isAdmin() || (signedIn() && userDoc().role == 'manager');
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && me() == uid;
      allow update: if me() == uid || isAdmin();   // role promotion = admin only
      allow delete: if isAdmin();
    }

    match /accounts/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      // owner can update own account; staff can service any account
      allow update: if signedIn() && (resource.data.ownerUid == me() || isStaff());
      allow delete: if isAdmin();
    }

    match /transactions/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /bankTransfers/{id} {
      allow read, create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /meraldVaults/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == me();
      allow update, delete: if signedIn() && (resource.data.ownerUid == me() || isStaff());
    }

    match /loans/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && (resource.data.ownerUid == me() || isStaff()); // staff approve/deny
      allow delete: if isAdmin();
    }

    match /bills/{id} {
      allow read: if signedIn();
      allow create: if isStaff() || isAdmin();
      allow update: if signedIn();          // paying a bill flips paid:true
      allow delete: if isAdmin();
    }

    // NEW — IUB Certificates of Deposit
    match /certificates/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == me();
      allow update: if signedIn() && (resource.data.ownerUid == me() || isStaff());
      allow delete: if isAdmin();
    }

    // NEW — VNB currency board (Valorian Franks per U.U.R. Emerul + spread). Admin-only writes.
    match /fx/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // NEW — VNB policy notices
    match /vnbNotices/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Network-wide administrator announcements shown on every signed-in site.
    match /networkNotices/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /stocks/{ticker} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if signedIn();  // trades update volume/price via transactions
    }

    match /market/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /positions/{id} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.resource.data.ownerUid == me()
                                    || (signedIn() && resource.data.ownerUid == me())
                                    || isAdmin();
    }

    match /trades/{id} {
      allow read, create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /watchlists/{id} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && id.matches(me() + '_.*');
    }

    match /casino/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /casinoPlayers/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid == me() || isAdmin();
      allow delete: if isAdmin();
    }

    match /casinoPlays/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == me() || isAdmin();
      allow delete: if signedIn() && resource.data.ownerUid == me() || isAdmin(); // "clear history"
      allow update: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /adminLogs/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && uid == me();
    }
  }
}
