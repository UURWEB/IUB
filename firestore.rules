rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(me())); }
    function profile() { return get(/databases/$(database)/documents/users/$(me())).data; }
    function myUsername() { return hasProfile() && profile().keys().hasAny(['username']) ? profile().username : ''; }
    function isHeadAdmin() { return signedIn() && me() == 'PTP7igQ2U2TlY5phreKl61H8plu1'; }
    function isAdmin() {
      return isHeadAdmin() || (signedIn() && (
        exists(/databases/$(database)/documents/admins/$(me())) ||
        (hasProfile() && profile().keys().hasAny(['role']) && profile().role == 'admin')
      ));
    }
    function isManager() { return signedIn() && hasProfile() && profile().keys().hasAny(['role']) && profile().role == 'manager'; }
    function isStaff() { return isAdmin() || isManager(); }
    function managesBank(bank) {
      return isAdmin() || (
        isManager() && profile().keys().hasAny(['managerBank']) &&
        (profile().managerBank == bank || profile().managerBank == 'ALL')
      );
    }

    function ownsData(data) {
      return signedIn() && (
        (data.keys().hasAny(['ownerUid']) && data.ownerUid == me()) ||
        (data.keys().hasAny(['uid']) && data.uid == me()) ||
        (data.keys().hasAny(['recipientUid']) && data.recipientUid == me()) ||
        (data.keys().hasAny(['ownerUsername']) && data.ownerUsername == myUsername())
      );
    }

    function isBusinessMember(businessId) {
      return signedIn() && businessId is string && businessId.size() > 0 &&
        exists(/databases/$(database)/documents/businessMembers/$(businessId + '_' + me()));
    }
    function businessMember(businessId) {
      return get(/databases/$(database)/documents/businessMembers/$(businessId + '_' + me())).data;
    }
    function isBusinessOwner(businessId) {
      return isBusinessMember(businessId) && businessMember(businessId).keys().hasAny(['role']) &&
        businessMember(businessId).role in ['owner', 'admin'];
    }
    function canBusiness(businessId, permission) {
      return isBusinessMember(businessId) && (
        isBusinessOwner(businessId) ||
        (businessMember(businessId).keys().hasAny(['permissions']) &&
         businessMember(businessId).permissions is list &&
         businessMember(businessId).permissions.hasAny([permission, 'all']))
      );
    }
    function businessLinked(data) {
      return data.keys().hasAny(['businessId']) && data.businessId is string && isBusinessMember(data.businessId);
    }

    function accountExists(accountId) {
      return accountId is string && exists(/databases/$(database)/documents/accounts/$(accountId));
    }
    function accountData(accountId) { return get(/databases/$(database)/documents/accounts/$(accountId)).data; }
    function ownsPersonalAccount(accountId) {
      return signedIn() && accountExists(accountId) &&
        accountData(accountId).keys().hasAny(['ownerUid']) && accountData(accountId).ownerUid == me() &&
        (!accountData(accountId).keys().hasAny(['ownerType']) || accountData(accountId).ownerType != 'business');
    }
    function usesBusinessAccount(accountId) {
      return signedIn() && accountExists(accountId) && accountData(accountId).keys().hasAny(['businessId']) &&
        isBusinessMember(accountData(accountId).businessId);
    }
    function canUseAccount(accountId) { return ownsPersonalAccount(accountId) || usesBusinessAccount(accountId) || isAdmin(); }
    function managesAccount(accountId) {
      return accountExists(accountId) && accountData(accountId).keys().hasAny(['bank']) && managesBank(accountData(accountId).bank);
    }
    function linkedToAuthorizedAccount(data) {
      return data.keys().hasAny(['accountId']) && (canUseAccount(data.accountId) || managesAccount(data.accountId));
    }

    match /admins/{uid} {
      allow read: if signedIn() && (uid == me() || isAdmin());
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (uid == me() || isAdmin());
      allow create: if (
        isAdmin() && (
          (uid == 'PTP7igQ2U2TlY5phreKl61H8plu1' && isHeadAdmin() && request.resource.data.role == 'head_admin') ||
          (uid != 'PTP7igQ2U2TlY5phreKl61H8plu1' && request.resource.data.role != 'head_admin')
        )
      ) || (
        signedIn() && uid == me() && uid != 'PTP7igQ2U2TlY5phreKl61H8plu1' &&
        request.resource.data.keys().hasAll(['username', 'role']) &&
        request.resource.data.role == 'user'
      );
      allow update: if (
        isHeadAdmin() && uid == 'PTP7igQ2U2TlY5phreKl61H8plu1'
      ) || (
        isAdmin() && uid != 'PTP7igQ2U2TlY5phreKl61H8plu1' &&
        (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role != 'head_admin')
      ) || (
        signedIn() && uid == me() && uid != 'PTP7igQ2U2TlY5phreKl61H8plu1' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'accountId','iubAccountId','meraldAccountId','vnbAccountId','lastLoginAt','updatedAt'
        ])
      );
      allow delete: if isAdmin() && uid != 'PTP7igQ2U2TlY5phreKl61H8plu1';
    }

    match /businesses/{businessId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isBusinessOwner(businessId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'description','industry','updatedAt'
        ])
      );
    }

    match /businessMembers/{memberId} {
      allow read: if signedIn() && (isAdmin() || resource.data.uid == me() || isBusinessMember(resource.data.businessId));
      allow create, update, delete: if isAdmin() || (
        request.resource.data.keys().hasAny(['businessId']) && isBusinessOwner(request.resource.data.businessId)
      ) || (
        resource.data.keys().hasAny(['businessId']) && isBusinessOwner(resource.data.businessId)
      );
    }

    match /businessApplications/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == me());
      allow create: if isHeadAdmin() || (signedIn() && request.resource.data.ownerUid == me());
      allow update, delete: if isAdmin();
    }

    match /businessProfitDistributions/{id} {
      allow read: if signedIn() && (isAdmin() || businessLinked(resource.data));
      allow create: if isAdmin() || (request.resource.data.keys().hasAny(['businessId']) && isBusinessOwner(request.resource.data.businessId));
      allow update, delete: if isAdmin();
    }

    match /accounts/{accountId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (
        signedIn() && request.resource.data.ownerUid == me() &&
        (!request.resource.data.keys().hasAny(['ownerType']) || request.resource.data.ownerType != 'business') &&
        request.resource.data.balance == 0 && request.resource.data.status == 'active' &&
        request.resource.data.bank in ['IUB','MERALD','VNB']
      );
      allow update: if isAdmin() ||
        (resource.data.keys().hasAny(['bank']) && managesBank(resource.data.bank) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance','status','updatedAt'])) ||
        (ownsPersonalAccount(accountId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'balance','updatedAt','lastTransferId','tradeDayKey','tradeCountToday','lastTradeAt',
            'lastCasinoPlayAt','meraldTransferLocked','meraldDailyTransferLimit','bankruptcyCaseId'
          ])) ||
        (usesBusinessAccount(accountId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'balance','updatedAt','lastTransferId','tradeDayKey','tradeCountToday','lastTradeAt',
            'lastCasinoPlayAt','meraldTransferLocked','meraldDailyTransferLimit'
          ])) ||
        (signedIn() && !canUseAccount(accountId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance','updatedAt','lastTransferId']) &&
          request.resource.data.balance is number && resource.data.balance is number &&
          request.resource.data.balance >= resource.data.balance);
      allow delete: if isAdmin();
    }

    match /transactions/{id} {
      allow read: if signedIn() && (isAdmin() || ownsData(resource.data) || businessLinked(resource.data) || linkedToAuthorizedAccount(resource.data) || (resource.data.keys().hasAny(['bank']) && managesBank(resource.data.bank)));
      allow create: if signedIn() && (isStaff() || ownsData(request.resource.data) || businessLinked(request.resource.data) || linkedToAuthorizedAccount(request.resource.data) || (request.resource.data.keys().hasAny(['createdBy']) && request.resource.data.createdBy == me()));
      allow update, delete: if isAdmin();
    }

    match /bankTransfers/{id} {
      allow read: if signedIn() && (isAdmin() || ownsData(resource.data) || (resource.data.keys().hasAny(['fromAccountId']) && canUseAccount(resource.data.fromAccountId)) || (resource.data.keys().hasAny(['toAccountId']) && canUseAccount(resource.data.toAccountId)));
      allow create: if signedIn() && request.resource.data.keys().hasAny(['fromAccountId']) && canUseAccount(request.resource.data.fromAccountId);
      allow update, delete: if isAdmin();
    }

    match /meraldVaults/{id} {
      allow read: if isAdmin() || managesBank('MERALD') || ownsData(resource.data) || businessLinked(resource.data);
      allow create: if signedIn() && request.resource.data.keys().hasAny(['accountId']) && canUseAccount(request.resource.data.accountId);
      allow update, delete: if isAdmin() || ownsData(resource.data) || businessLinked(resource.data);
    }

    match /loans/{id} {
      allow read: if isAdmin() || managesBank('IUB') || ownsData(resource.data) || businessLinked(resource.data) || linkedToAuthorizedAccount(resource.data);
      allow create: if signedIn() && (ownsData(request.resource.data) || businessLinked(request.resource.data) || linkedToAuthorizedAccount(request.resource.data) || managesBank('IUB'));
      allow update: if isAdmin() || managesBank('IUB') || ownsData(resource.data) || businessLinked(resource.data) || linkedToAuthorizedAccount(resource.data);
      allow delete: if isAdmin();
    }

    match /bills/{id} {
      allow read: if isAdmin() || managesBank('IUB') || ownsData(resource.data) || businessLinked(resource.data) || linkedToAuthorizedAccount(resource.data);
      allow create: if isAdmin() || managesBank('IUB');
      allow update: if isAdmin() || ownsData(resource.data) || businessLinked(resource.data) || linkedToAuthorizedAccount(resource.data);
      allow delete: if isAdmin();
    }

    match /certificates/{id} {
      allow read: if isAdmin() || managesBank('IUB') || ownsData(resource.data) || businessLinked(resource.data);
      allow create: if signedIn() && request.resource.data.keys().hasAny(['accountId']) && canUseAccount(request.resource.data.accountId);
      allow update, delete: if isAdmin() || ownsData(resource.data) || businessLinked(resource.data);
    }

    match /scheduledPayments/{id} {
      allow read: if isAdmin() || ownsData(resource.data) || businessLinked(resource.data);
      allow create: if isHeadAdmin() || (signedIn() && (request.resource.data.ownerUid == me() || businessLinked(request.resource.data)) && canUseAccount(request.resource.data.fromAccountId));
      allow update, delete: if isAdmin() || ownsData(resource.data) || businessLinked(resource.data);
    }

    match /savingsGoals/{id} {
      allow read, update, delete: if isAdmin() || ownsData(resource.data);
      allow create: if isHeadAdmin() || (signedIn() && request.resource.data.ownerUid == me());
    }

    match /payrollSchedules/{id} {
      allow read: if isAdmin() || businessLinked(resource.data) || resource.data.employeeUid == me();
      allow create: if isHeadAdmin() || (signedIn() && businessLinked(request.resource.data) && canBusiness(request.resource.data.businessId,'payroll'));
      allow update, delete: if isAdmin() || (businessLinked(resource.data) && canBusiness(resource.data.businessId,'payroll'));
    }

    match /invoices/{id} {
      allow read: if isAdmin() || resource.data.recipientUid == me() || resource.data.senderUid == me() || businessLinked(resource.data);
      allow create: if isHeadAdmin() || (signedIn() && (request.resource.data.senderUid == me() || (businessLinked(request.resource.data) && canBusiness(request.resource.data.businessId,'invoices'))));
      allow update: if isAdmin() || resource.data.recipientUid == me() || businessLinked(resource.data);
      allow delete: if isAdmin() || businessLinked(resource.data);
    }

    match /businessReports/{id} {
      allow read: if signedIn() && (resource.data.public == true || isAdmin() || businessLinked(resource.data));
      allow create: if isHeadAdmin() || (signedIn() && businessLinked(request.resource.data) && canBusiness(request.resource.data.businessId,'reports'));
      allow update, delete: if isAdmin() || (businessLinked(resource.data) && canBusiness(resource.data.businessId,'reports'));
    }

    match /stockApplications/{id} {
      allow read: if isAdmin() || businessLinked(resource.data);
      allow create: if isHeadAdmin() || (signedIn() && businessLinked(request.resource.data) && canBusiness(request.resource.data.businessId,'stock'));
      allow update, delete: if isAdmin();
    }

    match /mergerApplications/{id} {
      allow read: if isAdmin() || businessLinked(resource.data) || (resource.data.keys().hasAny(['targetBusinessId']) && isBusinessMember(resource.data.targetBusinessId));
      allow create: if isHeadAdmin() || (signedIn() && businessLinked(request.resource.data) && canBusiness(request.resource.data.businessId,'mergers'));
      allow update, delete: if isAdmin();
    }

    match /businessMigrations/{id} { allow read, write: if isAdmin(); }

    match /taxFilings/{id} {
      allow read: if isAdmin() || ownsData(resource.data) || businessLinked(resource.data);
      allow create: if isHeadAdmin() || (signedIn() && (request.resource.data.ownerUid == me() || businessLinked(request.resource.data)));
      allow update, delete: if isAdmin();
    }
    match /insuranceApplications/{id} {
      allow read: if isAdmin() || ownsData(resource.data) || businessLinked(resource.data);
      allow create: if isHeadAdmin() || (signedIn() && (request.resource.data.ownerUid == me() || businessLinked(request.resource.data)));
      allow update, delete: if isAdmin();
    }
    match /bankruptcyCases/{id} {
      allow read: if isAdmin() || ownsData(resource.data) || businessLinked(resource.data);
      allow create: if isHeadAdmin() || (signedIn() && (request.resource.data.ownerUid == me() || businessLinked(request.resource.data)));
      allow update, delete: if isAdmin();
    }
    match /collateralLoanApplications/{id} {
      allow read: if isAdmin() || ownsData(resource.data) || businessLinked(resource.data);
      allow create: if isHeadAdmin() || (signedIn() && (request.resource.data.ownerUid == me() || businessLinked(request.resource.data)));
      allow update, delete: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.recipientUid == me());
      allow create: if signedIn();
      allow update, delete: if isAdmin() || (signedIn() && resource.data.recipientUid == me());
    }


    /* Bank ownership is public to signed-in members; only administrators may
       change stakes or declare profit/loss periods. Individual settlement and
       capital-call records remain private to the affected owner/business. */
    match /bankOwnershipSettings/{bank} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /bankEquity/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /bankPeriods/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /bankOwnerSettlements/{id} {
      allow read: if isAdmin() || ownsData(resource.data) || businessLinked(resource.data);
      allow write: if isAdmin();
    }
    match /bankOwnerLiabilities/{id} {
      allow read: if isAdmin() || ownsData(resource.data) || businessLinked(resource.data);
      allow write: if isAdmin();
    }


    // ── Business invitations and ownership handoffs ──
    match /businessInvitations/{id} {
      allow read: if isAdmin() || (signedIn() && (
        resource.data.recipientUid == me() ||
        (resource.data.keys().hasAny(['businessId']) && isBusinessMember(resource.data.businessId))
      ));
      allow create: if signedIn() && request.resource.data.keys().hasAll(['businessId','recipientUid']) &&
        isBusinessOwner(request.resource.data.businessId);
      allow update: if isAdmin() || (signedIn() && (
        resource.data.recipientUid == me() ||
        (resource.data.keys().hasAny(['businessId']) && isBusinessOwner(resource.data.businessId))
      ));
      allow delete: if isAdmin() || (signedIn() && resource.data.keys().hasAny(['businessId']) && isBusinessOwner(resource.data.businessId));
    }
    match /businessOwnershipTransfers/{id} {
      allow read: if isAdmin() || (signedIn() && (
        resource.data.newOwnerUid == me() || resource.data.oldOwnerUid == me() ||
        (resource.data.keys().hasAny(['businessId']) && isBusinessMember(resource.data.businessId))
      ));
      allow create: if signedIn() && request.resource.data.keys().hasAll(['businessId','newOwnerUid']) &&
        isBusinessOwner(request.resource.data.businessId);
      allow update: if isAdmin() || (signedIn() && (
        resource.data.newOwnerUid == me() ||
        (resource.data.keys().hasAny(['businessId']) && isBusinessOwner(resource.data.businessId))
      ));
      allow delete: if isAdmin();
    }

    // ── Corporate registry, subsidiaries and intercompany actions ──
    match /corporateApplications/{id} {
      allow read: if isAdmin() || (signedIn() && (
        resource.data.submittedByUid == me() ||
        (resource.data.keys().hasAny(['parentBusinessId']) && isBusinessMember(resource.data.parentBusinessId)) ||
        (resource.data.keys().hasAny(['childBusinessId']) && isBusinessMember(resource.data.childBusinessId))
      ));
      allow create: if signedIn() && request.resource.data.keys().hasAll(['parentBusinessId','childBusinessId']) &&
        canBusiness(request.resource.data.parentBusinessId,'ownership');
      allow update, delete: if isAdmin();
    }
    match /corporateHoldings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /corporateActions/{id} {
      allow read: if isAdmin() || (signedIn() && (
        resource.data.submittedByUid == me() ||
        (resource.data.keys().hasAny(['fromBusinessId']) && isBusinessMember(resource.data.fromBusinessId)) ||
        (resource.data.keys().hasAny(['toBusinessId']) && isBusinessMember(resource.data.toBusinessId))
      ));
      allow create: if signedIn() && request.resource.data.keys().hasAll(['fromBusinessId','toBusinessId']) &&
        canBusiness(request.resource.data.fromBusinessId,'ownership');
      allow update, delete: if isAdmin();
    }

    // ── Bank operating income and treasury investments ──
    match /bankRevenueSettings/{bank} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /bankRevenueEntries/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /bankTreasuryInvestments/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Requests are created by the trusted password-recovery backend. Only the
    // UID-locked Head Administrator may inspect or change their status.
    match /passwordResetRequests/{id} {
      allow read, update, delete: if isHeadAdmin();
      allow create: if false;
    }

    match /economicPolicy/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /economicEstimates/{id} { allow read, write: if isAdmin(); }

    match /fx/{id} { allow read: if signedIn(); allow write: if isAdmin() || managesBank('VNB'); }
    match /vnbNotices/{id} { allow read: if signedIn(); allow write: if isAdmin() || managesBank('VNB'); }
    match /networkNotices/{id} { allow read: if signedIn(); allow write: if isAdmin(); }

    match /market/{id} { allow read: if signedIn(); allow write: if isAdmin() || managesBank('CSE'); }
    match /global/{id} { allow read: if signedIn(); allow write: if isAdmin() || managesBank('CSE'); }
    match /stocks/{ticker} {
      allow read: if signedIn();
      allow create, delete: if isAdmin() || managesBank('CSE');
      allow update: if isAdmin() || managesBank('CSE') || (
        signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'dayVolume','volume','lastTradeAt','updatedAt','previousPrice','price','lastMove',
          'lastActionMove','lastActionSide','lastActionShares','lastActionAt','lastActionTrader',
          'tradeNetPressure','tradeBuyPressure','tradeSellPressure'
        ])
      );
    }

    match /positions/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || managesBank('CSE') || (
        signedIn() && request.resource.data.keys().hasAny(['accountId']) && canUseAccount(request.resource.data.accountId) &&
        ((request.resource.data.keys().hasAny(['businessId']) && isBusinessMember(request.resource.data.businessId)) || request.resource.data.ownerUid == me())
      );
      allow update, delete: if isAdmin() || managesBank('CSE') || (
        signedIn() && resource.data.keys().hasAny(['accountId']) && canUseAccount(resource.data.accountId) &&
        (ownsData(resource.data) || businessLinked(resource.data))
      );
    }

    match /trades/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || managesBank('CSE') || (signedIn() && request.resource.data.keys().hasAny(['accountId']) && canUseAccount(request.resource.data.accountId));
      allow update, delete: if isAdmin() || managesBank('CSE');
    }

    match /watchlists/{id} {
      allow read: if signedIn();
      allow create: if isHeadAdmin() || (signedIn() && request.resource.data.ownerUid == me());
      allow update, delete: if isAdmin() || ownsData(resource.data);
    }

    match /limitOrders/{id} {
      allow read: if isAdmin() || managesBank('CSE') || ownsData(resource.data) || businessLinked(resource.data);
      allow create: if signedIn() && request.resource.data.keys().hasAny(['accountId']) && canUseAccount(request.resource.data.accountId);
      allow update: if isAdmin() || managesBank('CSE') || ownsData(resource.data) || businessLinked(resource.data);
      allow delete: if isAdmin() || managesBank('CSE');
    }

    match /shareholderVotes/{id} { allow read: if signedIn(); allow write: if isAdmin() || managesBank('CSE'); }
    match /shareholderBallots/{id} {
      allow read: if signedIn();
      allow create, update: if isHeadAdmin() || (signedIn() && request.resource.data.ownerUid == me());
      allow delete: if isAdmin() || ownsData(resource.data);
    }
    match /dividendPayments/{id} { allow read: if isAdmin() || ownsData(resource.data) || businessLinked(resource.data); allow write: if isAdmin() || managesBank('CSE'); }
    match /governmentBonds/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /bondHoldings/{id} { allow read: if isAdmin() || ownsData(resource.data) || businessLinked(resource.data); allow create, update: if isHeadAdmin() || (signedIn() && (request.resource.data.ownerUid == me() || businessLinked(request.resource.data))); allow delete: if isAdmin(); }
    match /investmentFunds/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /fundHoldings/{id} { allow read: if isAdmin() || ownsData(resource.data) || businessLinked(resource.data); allow create, update: if isHeadAdmin() || (signedIn() && (request.resource.data.ownerUid == me() || businessLinked(request.resource.data))); allow delete: if isAdmin(); }

    match /casino/{id} { allow read: if signedIn(); allow write: if isAdmin() || managesBank('OC'); }
    // House P/L ledger — every player's settle transaction increments it, so signed-in update is required.
    match /casino/house {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly([
        'houseNet','totalWagered','totalReturned','plays','updatedAt','resetAt','resetBy'
      ]);
      allow update: if isAdmin() || (signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'houseNet','totalWagered','totalReturned','plays','updatedAt'
        ])
      );
      allow delete: if isAdmin();
    }

    // ── U.U.R. Government (treasury, revenue ledger, tax assessments) ──
    // The treasury balance is incremented by players' casino settle transactions (winnings tax),
    // so signed-in create/update is required. All other government docs are admin-only.
    match /government/treasury {
      allow read: if signedIn();
      allow create: if isAdmin() || (signedIn() && request.resource.data.keys().hasOnly(['balance','updatedAt']) && request.resource.data.balance >= 0);
      allow update: if isAdmin() || (signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance','updatedAt']) &&
        request.resource.data.balance is number && resource.data.balance is number &&
        request.resource.data.balance >= resource.data.balance
      );
      allow delete: if isAdmin();
    }
    match /government/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /taxLedger/{id} {
      allow read: if isAdmin() || ownsData(resource.data);
      allow create: if isAdmin() || (signedIn() && request.resource.data.ownerUid == me() && request.resource.data.amount is number && request.resource.data.amount >= 0); // casino settles or administrator collections
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /taxAssessments/{id} {
      allow read: if isAdmin() || ownsData(resource.data);
      allow write: if isAdmin();
    }
    match /casinoPlayers/{uid} {
      allow read: if signedIn() && (uid == me() || isAdmin() || managesBank('OC'));
      allow create, update: if signedIn() && (uid == me() || isAdmin() || managesBank('OC'));
      allow delete: if isAdmin() || managesBank('OC');
    }
    match /casinoPlays/{id} {
      allow read: if isAdmin() || managesBank('OC') || ownsData(resource.data);
      allow create: if isHeadAdmin() || (signedIn() && request.resource.data.ownerUid == me() && canUseAccount(request.resource.data.accountId));
      allow update: if isAdmin() || managesBank('OC');
      allow delete: if isAdmin() || managesBank('OC') || ownsData(resource.data);
    }
    match /casinoTournaments/{id} { allow read: if signedIn(); allow write: if isAdmin() || managesBank('OC'); }
    match /casinoTournamentEntries/{id} {
      allow read: if isAdmin() || managesBank('OC') || ownsData(resource.data);
      allow create: if isHeadAdmin() || (signedIn() && request.resource.data.ownerUid == me() && canUseAccount(request.resource.data.accountId));
      allow update: if isAdmin() || managesBank('OC') || ownsData(resource.data);
      allow delete: if isAdmin() || managesBank('OC');
    }

    match /supportSessions/{id} {
      allow read, create, update, delete: if isHeadAdmin();
    }

    match /adminLogs/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.actorUid == me();
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /presence/{uid} {
      allow read: if isAdmin() || (signedIn() && uid == me());
      allow create, update, delete: if signedIn() && uid == me();
    }
    match /_ping/{id} { allow read, write: if signedIn(); }
    match /{document=**} { allow read, write: if false; }
  }
}
